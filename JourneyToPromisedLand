<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Journey to the Promised Land — Bible Quiz</title>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    html, body { height: 100%; overflow: hidden; font-family: 'Georgia', serif; }

    body {
      display: flex; flex-direction: column; height: 100vh;
      background: linear-gradient(150deg, #5a9fc0 0%, #b8904a 60%, #9c7838 100%);
    }

    /* ── TOP BAR ── */
    .topbar {
      flex-shrink: 0; height: 40px;
      display: flex; align-items: center; justify-content: center; gap: 12px;
      background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.15);
      padding: 0 16px;
    }
    .game-title { font-size: 1.1rem; color: #fff; text-shadow: 1px 2px 4px rgba(0,0,0,0.4); letter-spacing: 0.5px; }
    .game-sub   { font-size: 0.72rem; color: rgba(255,255,255,0.72); }

    /* ── MAIN SPLIT ── */
    .main-layout {
      flex: 1; min-height: 0;
      display: grid; grid-template-columns: 2fr 1fr;
    }

    /* ── LEFT: MAP ── */
    .map-panel { position: relative; background: #f0e0b4; overflow: hidden; }
    #journeyMap { width: 100%; height: 100%; display: block; }

    .stage-overlay {
      position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
      background: rgba(61,43,31,0.75); color: #fff;
      padding: 4px 16px; border-radius: 20px;
      font-size: 0.88rem; font-weight: bold; white-space: nowrap; pointer-events: none;
    }
    .wandering-banner {
      position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
      background: rgba(255,208,90,0.96); border-radius: 8px;
      padding: 5px 14px; font-style: italic; color: #5d3e10;
      font-size: 0.74rem; white-space: nowrap; display: none; pointer-events: none;
    }
    .wandering-banner.show { display: block; }

    /* ── RIGHT: QUIZ PANEL ── */
    .quiz-panel {
      background: rgba(255,255,255,0.97);
      display: flex; flex-direction: column;
      padding: 12px 13px 10px;
      overflow-y: auto; gap: 6px;
      border-left: 1px solid rgba(0,0,0,0.08);
    }

    /* Auto-advance progress bar */
    .advance-track {
      height: 3px; background: rgba(0,0,0,0.08); border-radius: 2px;
      overflow: hidden; flex-shrink: 0; opacity: 0; transition: opacity 0.2s;
    }
    .advance-track.active { opacity: 1; }
    .advance-fill {
      height: 100%; border-radius: 2px; width: 100%;
      transform-origin: left; background: #c4a35a;
    }
    .advance-fill.draining { transition: transform 2.4s linear; transform: scaleX(0); }

    .card-meta {
      display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
    }
    .q-counter { font-size: 0.68rem; color: #aaa; text-transform: uppercase; letter-spacing: 1px; }
    .score-dots { display: flex; gap: 3px; flex-wrap: wrap; justify-content: flex-end; max-width: 55%; }
    .score-dot  { width: 8px; height: 8px; border-radius: 50%; background: #e8e0d4; transition: background 0.3s; }
    .score-dot.correct { background: #4CAF50; }
    .score-dot.wrong   { background: #e74c3c; }

    .q-stage-label { font-size: 0.66rem; color: #c4a35a; text-transform: uppercase; letter-spacing: 1px; flex-shrink: 0; }
    .q-text { font-size: 0.97rem; color: #3d2b1f; line-height: 1.45; flex-shrink: 0; }

    /* ── D-PAD ── */
    .dpad { display: flex; flex-direction: column; align-items: center; gap: 5px; flex-shrink: 0; }
    .dpad-row { display: flex; justify-content: center; align-items: center; gap: 5px; }

    .dpad-btn {
      min-width: 108px; max-width: 145px; min-height: 52px;
      padding: 7px 9px;
      border: 2px solid #e4d9cc; background: #faf7f2;
      border-radius: 10px;
      font-family: 'Georgia', serif; color: #3d2b1f;
      cursor: pointer;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
      transition: border-color 0.14s, background 0.14s, transform 0.14s;
      touch-action: manipulation;
      -webkit-user-select: none; user-select: none;
    }
    .dpad-btn:hover:not(:disabled) { border-color: #c4a35a; background: #fef9f0; }
    .dpad-btn:active:not(:disabled) { transform: scale(0.97); }
    .dpad-btn:disabled { opacity: 0.72; cursor: default; }
    .dpad-btn.correct  { border-color: #4CAF50; background: #f0fff4; }
    .dpad-btn.wrong    { border-color: #e74c3c; background: #fff5f5; }
    .dpad-btn.flash    { border-color: #c4a35a; background: #fef9f0; transform: scale(1.05); }

    .dpad-arrow { font-size: 0.9rem; opacity: 0.38; line-height: 1; }
    .dpad-txt   { font-size: 0.74rem; line-height: 1.25; text-align: center; }
    .dpad-center {
      width: 40px; height: 40px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; background: rgba(196,163,90,0.1); border-radius: 50%;
    }

    .key-hint { font-size: 0.63rem; color: #bbb; text-align: center; flex-shrink: 0; }

    /* ── FEEDBACK ── */
    .feedback {
      padding: 9px 12px; border-radius: 8px;
      font-size: 0.8rem; line-height: 1.42; display: none; flex-shrink: 0;
    }
    .feedback.correct { background: #f0fff4; color: #2d6a4f; border-left: 3px solid #4CAF50; }
    .feedback.wrong   { background: #fff5f5; color: #7b2d2d; border-left: 3px solid #e74c3c; }
    .feedback.show    { display: block; animation: slideUp 0.22s ease; }

    /* ── MODALS ── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.68);
      display: none; align-items: center; justify-content: center;
      z-index: 100; padding: 20px;
    }
    .modal-overlay.show { display: flex; animation: fadeIn 0.3s ease; }

    .modal-card {
      background: #fff; border-radius: 20px;
      padding: 30px 26px; max-width: 480px; width: 100%;
      max-height: 92vh; overflow-y: auto; text-align: center;
      box-shadow: 0 24px 60px rgba(0,0,0,0.5);
      animation: slideUp 0.3s ease;
    }
    .modal-card .big-icon, .modal-card .win-icon { font-size: 2.6rem; margin-bottom: 10px; display: block; }
    .modal-card h2  { font-size: 1.5rem; color: #3d2b1f; margin-bottom: 9px; }
    .modal-card p   { color: #6d4c41; font-size: 0.92rem; line-height: 1.62; margin-bottom: 18px; }
    .player-title   { font-size: 1.15rem; color: #c4a35a; font-weight: bold; margin-bottom: 12px; }
    .score-big      { font-size: 2.5rem; font-weight: bold; color: #4CAF50; }
    .score-of       { font-size: 0.84rem; color: #aaa; margin-bottom: 18px; }
    .win-verse {
      background: #faf7f2; border-left: 3px solid #c4a35a;
      padding: 12px 14px; border-radius: 0 10px 10px 0;
      font-style: italic; color: #5d4037; line-height: 1.62;
      text-align: left; margin-bottom: 14px; font-size: 0.84rem;
    }
    .book-rec { background: #f0fff4; border-radius: 10px; padding: 12px 14px; text-align: left; margin-bottom: 18px; }
    .book-rec h3 { color: #2d6a4f; font-size: 0.82rem; margin-bottom: 4px; }
    .book-rec p  { color: #3d2b1f; font-size: 0.8rem; line-height: 1.48; }
    .action-btn {
      width: 100%; padding: 13px;
      background: linear-gradient(135deg, #c4a35a, #d4a847);
      color: #fff; border: none; border-radius: 12px;
      font-size: 0.92rem; font-family: 'Georgia', serif;
      cursor: pointer; transition: all 0.18s ease; touch-action: manipulation;
    }
    .action-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 16px rgba(196,163,90,0.45); }
    .action-btn:active { transform: scale(0.98); }

    @keyframes slideUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
    @keyframes fadeIn  { from { opacity:0; } to { opacity:1; } }

    /* ── MOBILE (portrait) ── */
    @media (max-width: 680px) {
      .game-sub  { display: none; }
      .topbar    { height: 38px; }
      .key-hint  { display: none; }

      .main-layout {
        grid-template-columns: 1fr;
        grid-template-rows: min(40vh, 300px) 1fr;
      }

      .quiz-panel { padding: 10px 11px 8px; gap: 5px; overflow-y: auto; }
      .q-text { font-size: 0.93rem; }

      .dpad-btn {
        min-width: 105px; max-width: 138px;
        min-height: 54px; padding: 6px 8px;
      }
      .dpad-txt  { font-size: 0.76rem; }
      .dpad-arrow { font-size: 0.85rem; }
      .dpad-center { width: 38px; height: 38px; font-size: 1.2rem; }

      .feedback { font-size: 0.78rem; padding: 8px 11px; }

      .modal-card { padding: 22px 18px; }
      .modal-card h2 { font-size: 1.3rem; }
    }

    /* ── LANDSCAPE PHONE ── */
    @media (max-height: 500px) and (orientation: landscape) {
      .main-layout { grid-template-columns: 2fr 1fr; }
      .topbar { height: 34px; }
      .game-sub { display: none; }
      .dpad-btn { min-width: 85px; min-height: 44px; padding: 4px 6px; }
      .dpad-txt  { font-size: 0.68rem; }
      .dpad-center { width: 32px; height: 32px; font-size: 1rem; }
      .dpad { gap: 3px; }
      .dpad-row { gap: 3px; }
      .quiz-panel { gap: 4px; padding: 8px 10px; }
      .q-text { font-size: 0.85rem; }
    }
  </style>
</head>
<body>

  <header class="topbar">
    <h1 class="game-title">Journey to the Promised Land</h1>
    <span class="game-sub">A Bible quiz adventure through the wilderness</span>
  </header>

  <div class="main-layout">

    <!-- LEFT: MAP (2/3) -->
    <div class="map-panel">
      <svg id="journeyMap" viewBox="0 0 500 480" preserveAspectRatio="xMidYMid slice">

        <rect width="500" height="480" fill="#f0e0b4"/>

        <!-- Mediterranean Sea -->
        <path d="M0,0 L500,0 L500,115 Q428,94 348,108 Q272,120 196,102 Q124,86 56,104 L0,115 Z"
              fill="#8ec9e0" opacity="0.65"/>
        <text x="220" y="66" font-size="12" fill="#3a7fa8" font-style="italic" opacity="0.68" text-anchor="middle">Mediterranean Sea</text>

        <!-- Egypt / Nile -->
        <ellipse cx="24" cy="305" rx="28" ry="68" fill="#9ec87a" opacity="0.33"/>
        <path d="M24,480 Q28,415 38,358 Q50,318 58,308" stroke="#5ea8c5" stroke-width="4" fill="none" opacity="0.45"/>
        <text x="26" y="332" font-size="9" fill="#4a7030" font-style="italic" opacity="0.58" text-anchor="middle" transform="rotate(-15,26,332)">Egypt</text>

        <!-- Gulf of Suez -->
        <path d="M98,290 Q86,340 74,390 Q66,432 70,480"
              stroke="#8ec9e0" stroke-width="16" fill="none" stroke-linecap="round" opacity="0.55"/>

        <!-- Gulf of Aqaba -->
        <path d="M186,338 Q193,378 197,420 Q199,454 197,480"
              stroke="#8ec9e0" stroke-width="12" fill="none" stroke-linecap="round" opacity="0.5"/>

        <!-- Sinai Peninsula -->
        <path d="M98,290 Q148,480 190,480 Q215,480 188,338 Q146,306 98,290 Z"
              fill="#d4a86a" opacity="0.36"/>

        <!-- Sinai mountain -->
        <path d="M136,374 L148,350 L160,374 Z" fill="#b8904a" opacity="0.55"/>

        <!-- Jordan River -->
        <path d="M353,178 Q346,213 340,245 Q333,278 328,310"
              stroke="#8ec9e0" stroke-width="5" fill="none" opacity="0.6"/>

        <!-- Sea of Galilee -->
        <ellipse cx="353" cy="185" rx="9" ry="13" fill="#8ec9e0" opacity="0.55"/>

        <!-- Dead Sea -->
        <ellipse cx="326" cy="322" rx="12" ry="22" fill="#8ec9e0" opacity="0.65"/>
        <text x="342" y="322" font-size="7.5" fill="#3a7fa8" opacity="0.72">Dead Sea</text>

        <!-- Canaan -->
        <path d="M308,110 Q366,88 448,98 Q488,106 497,148 Q497,275 458,308 Q418,328 378,298 Q338,268 322,228 Q308,195 308,110 Z"
              fill="#a8c87a" opacity="0.22"/>
        <text x="405" y="178" font-size="11" fill="#3a7030" font-style="italic" opacity="0.62" text-anchor="middle">Canaan</text>

        <text x="205" y="250" font-size="9" fill="#8a6030" font-style="italic" opacity="0.48" text-anchor="middle">Wilderness</text>

        <!-- Journey path -->
        <path d="M 58,308 Q 82,296 102,286 Q 140,272 168,308 Q 158,358 148,398
                 Q 194,360 248,268 Q 300,228 353,198 Q 398,178 450,142"
              stroke="#c4a35a" stroke-width="2.5" fill="none" stroke-dasharray="8,5" opacity="0.85"/>

        <g id="stageMarkersGroup"></g>

        <!-- Pilgrim -->
        <g id="pilgrimGroup" style="transform:translate(58px,308px);transition:transform 1s cubic-bezier(0.4,0,0.2,1)">
          <ellipse cx="4" cy="1" rx="11" ry="4" fill="rgba(0,0,0,0.2)"/>
          <line x1="16" y1="-46" x2="21" y2="1" stroke="#6b4226" stroke-width="2" stroke-linecap="round"/>
          <path d="M-3,-30 Q4,-33 11,-30 L14,-6 Q4,-1 -7,-6 Z" fill="#c8a87a"/>
          <path d="M-7,-26 Q-11,-13 -9,-5 Q-2,2 9,0 L12,-24 Q4,-27 -7,-26 Z" fill="#9e7a42" opacity="0.78"/>
          <circle cx="3" cy="-41" r="8" fill="#f4c89a"/>
          <path d="M-5,-37 Q3,-52 11,-37 Q9,-28 -3,-28 Z" fill="#8B6914"/>
          <circle cx="1"  cy="-42" r="1.2" fill="#4a2c1a"/>
          <circle cx="6"  cy="-42" r="1.2" fill="#4a2c1a"/>
          <path d="M0,-38.5 Q3,-36 7,-38.5" stroke="#4a2c1a" stroke-width="0.9" fill="none"/>
          <line id="legL" x1="-2" y1="-6" x2="-5" y2="1" stroke="#6b4226" stroke-width="2.8" stroke-linecap="round"/>
          <line id="legR" x1="8"  y1="-6" x2="11" y2="1" stroke="#6b4226" stroke-width="2.8" stroke-linecap="round"/>
          <!-- Wandering indicator — hidden by default, shown during 40-year penalty -->
          <text id="wanderMark" text-anchor="middle" y="-64" font-size="13" fill="#8B6914"
                opacity="0" style="transition:opacity 0.5s; font-style:italic">???</text>
        </g>

      </svg>

      <div class="stage-overlay" id="stageName">Egypt — The Beginning</div>
      <div class="wandering-banner" id="wanderingBanner">
        ⏳ 40 Years of Wandering — answer these to cross the Jordan...
      </div>
    </div>

    <!-- RIGHT: QUIZ (1/3) -->
    <div class="quiz-panel">
      <div class="advance-track" id="advanceTrack"><div class="advance-fill" id="advanceFill"></div></div>
      <div class="card-meta">
        <span class="q-counter" id="qCounter">Question 1 of 15</span>
        <div class="score-dots" id="scoreDots"></div>
      </div>
      <div class="q-stage-label" id="qStageLabel"></div>
      <p class="q-text" id="qText"></p>

      <div class="dpad">
        <div class="dpad-row">
          <button class="dpad-btn" id="dpad-0" onclick="answer(0)">
            <span class="dpad-arrow">↑</span><span class="dpad-txt" id="dtxt-0"></span>
          </button>
        </div>
        <div class="dpad-row">
          <button class="dpad-btn" id="dpad-3" onclick="answer(3)">
            <span class="dpad-arrow">←</span><span class="dpad-txt" id="dtxt-3"></span>
          </button>
          <div class="dpad-center">🧭</div>
          <button class="dpad-btn" id="dpad-1" onclick="answer(1)">
            <span class="dpad-arrow">→</span><span class="dpad-txt" id="dtxt-1"></span>
          </button>
        </div>
        <div class="dpad-row">
          <button class="dpad-btn" id="dpad-2" onclick="answer(2)">
            <span class="dpad-arrow">↓</span><span class="dpad-txt" id="dtxt-2"></span>
          </button>
        </div>
      </div>

      <p class="key-hint">Arrow keys ↑ ← → ↓ · tap/press any key to skip</p>
      <div class="feedback" id="feedback"></div>
    </div>

  </div>

  <!-- MODAL: KADESH -->
  <div class="modal-overlay" id="kadeshScreen">
    <div class="modal-card">
      <span class="big-icon">⚠️</span>
      <h2>Kadesh Barnea</h2>
      <p>
        The ten spies returned with fear: <em>"The people are giants — we seemed like grasshoppers!"</em>
        The whole assembly wept and refused to enter the land.<br><br>
        Only Joshua and Caleb cried: <em>"The LORD is with us — do not fear!"</em>
        But the people would not listen. And so the wilderness became home for another generation.
      </p>
      <button class="action-btn" onclick="startWandering()">Begin the 40 years of wandering →</button>
    </div>
  </div>

  <!-- MODAL: WIN -->
  <div class="modal-overlay" id="winScreen">
    <div class="modal-card">
      <span class="win-icon" id="winIcon">🌟</span>
      <h2>You have reached the Promised Land!</h2>
      <div class="player-title" id="playerTitle"></div>
      <div class="score-big"  id="scoreBig"></div>
      <div class="score-of"   id="scoreOf"></div>
      <div class="win-verse"  id="winVerse"></div>
      <div class="book-rec">
        <h3>📖 Recommended reading for your journey</h3>
        <p id="bookRecText"></p>
      </div>
      <button class="action-btn" onclick="restartGame()">Take the journey again 🔄</button>
    </div>
  </div>

<script>
// ═══════════════════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════════════════

const WAYPOINTS = [
  [58,  308], // Egypt
  [102, 286], // Red Sea
  [168, 308], // Wilderness
  [148, 398], // Mt. Sinai
  [248, 268], // Kadesh Barnea
  [353, 198], // Jordan River
  [450, 142], // Promised Land
];

// Positions the pilgrim wanders to after each 40-year penalty question —
// zigzag through the Sinai wilderness before eventually reaching the Jordan
const WANDER_POSITIONS = [
  [155, 362],  // Q1 — deeper into Sinai, heading south
  [106, 318],  // Q2 — drifts back west toward Egypt (frustratingly backward)
  [198, 340],  // Q3 — circles back east, aimless in the wilderness
];

const STAGES = [
  { name:'Egypt',         icon:'🏛️' },
  { name:'Red Sea',       icon:'🌊' },
  { name:'Wilderness',    icon:'🏜️' },
  { name:'Mt. Sinai',     icon:'⛰️' },
  { name:'Kadesh Barnea', icon:'⚠️' },
  { name:'Jordan River',  icon:'🌿' },
  { name:'Promised Land', icon:'🌟' },
];

const QUESTIONS = [
  // EGYPT
  { stage:0, text:'Who did God choose to lead the Israelites out of Egypt?',
    options:['Aaron','Moses','Joshua','Caleb'], correct:1,
    ok:'✅ The pillar of cloud moves forward! Moses answered God\'s call at the burning bush.',
    fail:'💬 It was Moses — called by God from a burning bush — who led His people out.' },
  { stage:0, text:'How many plagues did God send upon Egypt before Pharaoh released the Israelites?',
    options:['7','8','10','12'], correct:2,
    ok:'✅ Ten plagues — from frogs and locusts to thick darkness — each greater than the last.',
    fail:'💬 God sent 10 plagues upon Egypt, escalating until the final Passover night.' },
  { stage:0, text:'What did the Israelites put on their doorposts on the night of the first Passover?',
    options:['Olive oil','Water','Lamb\'s blood','Salt'], correct:2,
    ok:'✅ The blood of the lamb marked the faithful — and the angel of death passed over.',
    fail:'💬 The lamb\'s blood on the doorposts was the sign of salvation that night.' },

  // RED SEA
  { stage:1, text:'What happened when Moses stretched his staff over the Red Sea?',
    options:['It began to rain','The waters divided','Fish leaped ashore','A wind pushed them over'], correct:1,
    ok:'✅ The waters divided — Israel walked through on dry ground!',
    fail:'💬 God split the sea so His people could walk through on dry ground.' },
  { stage:1, text:'After crossing the Red Sea, what did Miriam lead the women in doing?',
    options:['Building an altar','Counting the people','Singing and dancing with tambourines','Writing the law'], correct:2,
    ok:'✅ "Sing to the LORD, for He is highly exalted!" — Miriam, with her tambourine.',
    fail:'💬 Miriam led the women in song and dancing with tambourines — celebrating God\'s victory.' },

  // WILDERNESS
  { stage:2, text:'The Israelites couldn\'t drink the water at Marah. What was wrong with it?',
    options:['Too deep to reach','Boiling hot','It was bitter','There was barely any'], correct:2,
    ok:'✅ The water was bitter — God showed Moses a piece of wood to throw in, and it became sweet.',
    fail:'💬 The water at Marah was bitter. God showed Moses a piece of wood to make it drinkable.' },
  { stage:2, text:'What food did God rain down from heaven to feed the Israelites?',
    options:['Manna','Figs','Dates','Honeycomb'], correct:0,
    ok:'✅ Manna! "What is it?" the people asked — bread from heaven, fresh each morning.',
    fail:'💬 God provided manna — a flaky, white substance that appeared each morning like dew.' },
  { stage:2, text:'When they complained about no meat, what did God send?',
    options:['Fish','Deer','Quail','Lambs'], correct:2,
    ok:'✅ God sent a wind that swept in quail — so many they covered the camp!',
    fail:'💬 God sent quail — birds carried by the wind that blanketed the camp.' },

  // MT. SINAI
  { stage:3, text:'How many commandments did God give Moses on Mt. Sinai?',
    options:['7','10','12','15'], correct:1,
    ok:'✅ Ten Commandments — written by the very finger of God on two stone tablets!',
    fail:'💬 God gave Moses Ten Commandments — the moral foundation of the covenant.' },
  { stage:3, text:'What did the Israelites make while Moses was on the mountain?',
    options:['A stone temple','A golden calf','A wooden throne','A silver altar'], correct:1,
    ok:'✅ A golden calf — Israel turned to idols at the very moment God was writing His law!',
    fail:'💬 The people melted their gold and made a golden calf to worship.' },
  { stage:3, text:'How long was Moses on Mt. Sinai when he received the law?',
    options:['7 days','14 days','30 days','40 days and nights'], correct:3,
    ok:'✅ Forty days and forty nights — Moses fasted without bread or water the entire time.',
    fail:'💬 Moses was on the mountain for 40 days and 40 nights — without bread or water.' },

  // ── KADESH BARNEA — TRAP QUESTION ──────────────────────
  // Most people will guess "Fast and pray" or "Send more spies" — but the
  // actual recorded response (Numbers 14:4) is shockingly faithless.
  { stage:4, isKadesh:true,
    text:'After the spies\' fearful report, what did the people of Israel actually propose doing?',
    options:[
      'Fast and pray for three days',
      'Appoint a new leader and return to Egypt',
      'Send a second group of spies',
      'Build an altar and seek God\'s guidance',
    ],
    correct:1,
    ok:'✅ Correct — they truly proposed returning to Egypt! (Numbers 14:4) Their faithlessness led directly to the 40 years of wandering.',
    fail:'💬 Shockingly, they proposed appointing a new leader to march back to Egypt (Numbers 14:4). Most people guess "pray" — but that\'s not what they did. Their faithlessness led to 40 years of wandering.' },

  // JORDAN RIVER
  { stage:5, text:'Who led the Israelites into the Promised Land after Moses died?',
    options:['Aaron','Caleb','Joshua','Eleazar'], correct:2,
    ok:'✅ "As I was with Moses, so I will be with you." God chose Joshua to lead them in.',
    fail:'💬 Joshua — Moses\' faithful aide — was appointed by God to lead the next generation.' },
  { stage:5, text:'What happened to the Jordan River when the priests stepped into it?',
    options:['It flooded over','It turned red','The water stopped flowing','A rainbow appeared'], correct:2,
    ok:'✅ The Jordan stopped the moment the priests\' feet touched it — dry ground crossing, just like the Red Sea!',
    fail:'💬 God held back the Jordan River and all Israel crossed on dry ground.' },
  { stage:5, text:'What was the first city the Israelites conquered in Canaan?',
    options:['Jerusalem','Jericho','Bethlehem','Hebron'], correct:1,
    ok:'✅ Jericho! Its walls fell not by swords, but by seven days of marching and trumpet blasts.',
    fail:'💬 Jericho was first — its walls fell after seven days of marching and priests blowing trumpets.' },
];

const WANDERING_QS = [
  { text:'For how many years did the Israelites wander because of their unbelief at Kadesh?',
    options:['7 years','20 years','40 years','70 years'], correct:2,
    ok:'✅ Forty years — one for each day the spies explored. A whole generation passed in the wilderness.',
    fail:'💬 God declared 40 years of wandering — one year for each day of exploration.' },
  { text:'Which two faithful spies were allowed to enter the Promised Land?',
    options:['Moses and Aaron','Joshua and Caleb','Samuel and David','Gideon and Barak'], correct:1,
    ok:'✅ Joshua and Caleb — the two who trusted God — were the only ones of their generation to enter Canaan.',
    fail:'💬 Joshua and Caleb gave a faithful report and were the only two of their generation to enter.' },
  { text:'On which mountain was Moses shown the Promised Land before he died?',
    options:['Mt. Sinai','Mt. Carmel','Mt. Nebo','Mt. Hermon'], correct:2,
    ok:'✅ Mt. Nebo — God showed Moses all the land from its summit, and there Moses died at 120 years old.',
    fail:'💬 Mt. Nebo — where God showed Moses all the land, and where Moses died overlooking the promise.' },
];

const OUTCOMES = [
  { min:90, icon:'🏆', title:'Faithful Scout',
    verse:'"Be strong and courageous. Do not be afraid, for the LORD your God will be with you wherever you go." — Joshua 1:9',
    book:'You\'re ready to go deep. The ESV Study Bible or NIV Biblical Theology Study Bible will give you the rich depth your knowledge can handle.' },
  { min:70, icon:'🌟', title:'Desert Pilgrim',
    verse:'"The LORD your God carried you, as a father carries his son, all the way you went." — Deuteronomy 1:31',
    book:'"The Story" by Max Lucado walks through the whole Bible in one readable account — perfect for seeing how this journey fits the bigger picture.' },
  { min:50, icon:'⛺', title:'Wilderness Wanderer',
    verse:'"He humbled you... to teach you that man does not live on bread alone." — Deuteronomy 8:3',
    book:'"The Jesus Storybook Bible" by Sally Lloyd-Jones beautifully retells the whole Bible story — brilliant for any age.' },
  { min:0,  icon:'🏕️', title:'Just Left Egypt',
    verse:'"I will be with you; I will never leave you nor forsake you." — Joshua 1:5',
    book:'Start with The Bible Project\'s free YouTube series on the Pentateuch — it makes the story of Israel\'s journey come alive visually.' },
];

// ═══════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════

let S = {
  qi:0, correct:0, stage:0,
  wandering:false, wi:0,
  kadeshFailed:false, answered:false,
};

// ═══════════════════════════════════════════════════════
// AUTO-ADVANCE
// ═══════════════════════════════════════════════════════

let advanceTimer = null;
let advancing    = false;

function scheduleAdvance() {
  const track = document.getElementById('advanceTrack');
  const fill  = document.getElementById('advanceFill');
  // Reset bar
  fill.className = 'advance-fill';
  fill.style.transform = 'scaleX(1)';
  track.classList.add('active');
  // Kick off drain animation on next frame
  requestAnimationFrame(() => requestAnimationFrame(() => {
    fill.className = 'advance-fill draining';
  }));
  advanceTimer = setTimeout(() => { advanceTimer = null; nextQuestion(); }, 2400);
}

function stopBar() {
  document.getElementById('advanceTrack').classList.remove('active');
}

// Skip the timer — called from tap/keydown
function skipAdvance() {
  if (!advanceTimer || !S.answered || advancing) return;
  clearTimeout(advanceTimer); advanceTimer = null;
  nextQuestion();
}

// ═══════════════════════════════════════════════════════
// WALKING ANIMATION
// ═══════════════════════════════════════════════════════

let walkPhase = 0, walkRafId = null;

function walkTick() {
  // Walk faster and more erratically when lost in the wilderness
  walkPhase += S.wandering ? 0.22 : 0.14;
  const swing  = Math.sin(walkPhase) * 6;
  const bounce = Math.abs(Math.sin(walkPhase * 2)) * -1.5;
  const lL = document.getElementById('legL'), lR = document.getElementById('legR');
  if (lL && lR) {
    lL.setAttribute('x2', String(-5 + swing));  lL.setAttribute('y2', String(1 + bounce));
    lR.setAttribute('x2', String(11 - swing));  lR.setAttribute('y2', String(1 + bounce));
  }
  // Bob the ??? mark while wandering
  if (S.wandering) {
    const mark = document.getElementById('wanderMark');
    if (mark) mark.setAttribute('dy', String(Math.sin(walkPhase * 0.55) * 3));
  }
  walkRafId = requestAnimationFrame(walkTick);
}
function startWalk(ms) {
  if (!walkRafId) walkRafId = requestAnimationFrame(walkTick);
  setTimeout(stopWalk, ms || 1100);
}
function stopWalk() {
  if (walkRafId) { cancelAnimationFrame(walkRafId); walkRafId = null; }
  const lL = document.getElementById('legL'), lR = document.getElementById('legR');
  if (lL) { lL.setAttribute('x2','-5'); lL.setAttribute('y2','1'); }
  if (lR) { lR.setAttribute('x2','11'); lR.setAttribute('y2','1'); }
}

// ═══════════════════════════════════════════════════════
// MAP
// ═══════════════════════════════════════════════════════

const NS = 'http://www.w3.org/2000/svg';

function buildStageMarkers() {
  const g = document.getElementById('stageMarkersGroup');
  STAGES.forEach((st, i) => {
    const [x, y] = WAYPOINTS[i];
    const grp = document.createElementNS(NS,'g');
    grp.id = 'sm-' + i;
    grp.setAttribute('transform', `translate(${x},${y-22})`);
    const c = document.createElementNS(NS,'circle');
    c.setAttribute('r','13');
    c.setAttribute('fill','rgba(255,255,255,0.3)');
    c.setAttribute('stroke','rgba(255,255,255,0.4)');
    c.setAttribute('stroke-width','1.5');
    const icon = document.createElementNS(NS,'text');
    icon.setAttribute('text-anchor','middle'); icon.setAttribute('dominant-baseline','central');
    icon.setAttribute('font-size','12'); icon.textContent = st.icon;
    const lbl = document.createElementNS(NS,'text');
    lbl.setAttribute('text-anchor','middle'); lbl.setAttribute('y','22');
    lbl.setAttribute('font-size','8'); lbl.setAttribute('fill','#5d3e10');
    lbl.setAttribute('font-style','italic'); lbl.textContent = st.name;
    grp.appendChild(c); grp.appendChild(icon); grp.appendChild(lbl);
    g.appendChild(grp);
  });
}

function buildDots() {
  const wrap = document.getElementById('scoreDots');
  wrap.innerHTML = '';
  QUESTIONS.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'score-dot'; d.id = 'dot-' + i;
    wrap.appendChild(d);
  });
}

function syncMap(prevStage) {
  const idx = Math.min(S.stage, STAGES.length - 1);
  const [wx, wy] = WAYPOINTS[idx];
  document.getElementById('pilgrimGroup').style.transform = `translate(${wx}px,${wy}px)`;
  if (prevStage !== undefined && prevStage !== S.stage) startWalk(1100);
  document.getElementById('stageName').textContent = STAGES[idx].name;
  STAGES.forEach((_, i) => {
    const el = document.getElementById('sm-' + i); if (!el) return;
    const c = el.querySelector('circle');
    if (c) {
      c.setAttribute('fill', i < S.stage ? '#FFD700' : i === S.stage ? 'rgba(255,255,255,0.88)' : 'rgba(255,255,255,0.3)');
      c.setAttribute('stroke', i < S.stage ? '#e0b800' : i === S.stage ? '#fff' : 'rgba(255,255,255,0.4)');
    }
  });
}

function showModal(id) { document.getElementById(id).className = 'modal-overlay show'; }
function hideModal(id) { document.getElementById(id).className = 'modal-overlay'; }

// ═══════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════

function currentQ() { return S.wandering ? WANDERING_QS[S.wi] : QUESTIONS[S.qi]; }

function renderQuestion() {
  advancing = false;
  S.answered = false;
  stopBar();
  const q = currentQ();

  document.getElementById('qCounter').textContent = S.wandering
    ? `Wandering — ${S.wi + 1} of ${WANDERING_QS.length}`
    : `Question ${S.qi + 1} of ${QUESTIONS.length}`;

  document.getElementById('qStageLabel').textContent = S.wandering
    ? 'WANDERING — 40 YEARS IN THE WILDERNESS'
    : STAGES[q.stage].name.toUpperCase() + ' — STAGE ' + (q.stage + 1);

  document.getElementById('qText').textContent = q.text;

  [0,1,2,3].forEach(i => {
    const btn = document.getElementById('dpad-' + i);
    btn.className = 'dpad-btn'; btn.disabled = false;
    btn.onclick = () => answer(i);
    document.getElementById('dtxt-' + i).textContent = q.options[i];
  });

  const fb = document.getElementById('feedback');
  fb.className = 'feedback'; fb.textContent = '';
}

// ═══════════════════════════════════════════════════════
// ANSWER
// ═══════════════════════════════════════════════════════

function answer(idx) {
  if (S.answered || advancing) return;
  S.answered = true;
  const q = currentQ();
  const correct = idx === q.correct;

  [0,1,2,3].forEach(i => document.getElementById('dpad-' + i).disabled = true);
  document.getElementById('dpad-' + idx).classList.add(correct ? 'correct' : 'wrong');
  if (!correct) document.getElementById('dpad-' + q.correct).classList.add('correct');

  const fb = document.getElementById('feedback');
  fb.className = `feedback ${correct ? 'correct' : 'wrong'} show`;
  fb.textContent = correct ? q.ok : q.fail;

  if (!S.wandering) {
    const dot = document.getElementById('dot-' + S.qi);
    if (correct) { S.correct++; if (dot) dot.className = 'score-dot correct'; }
    else { if (dot) dot.className = 'score-dot wrong'; if (q.isKadesh) S.kadeshFailed = true; }
  }

  // During the 40-year wandering, move the pilgrim to the next wilderness position
  if (S.wandering && S.wi < WANDER_POSITIONS.length) {
    const [wx, wy] = WANDER_POSITIONS[S.wi];
    document.getElementById('pilgrimGroup').style.transform = `translate(${wx}px,${wy}px)`;
    startWalk(1400);
  }

  scheduleAdvance();
}

// ═══════════════════════════════════════════════════════
// KEYBOARD & POINTER (for skipping / arrow-key answers)
// ═══════════════════════════════════════════════════════

document.addEventListener('keydown', e => {
  const map = { ArrowUp:0, ArrowRight:1, ArrowDown:2, ArrowLeft:3 };
  if (!S.answered) {
    const idx = map[e.key];
    if (idx !== undefined) {
      e.preventDefault();
      const btn = document.getElementById('dpad-' + idx);
      btn.classList.add('flash');
      setTimeout(() => { btn.classList.remove('flash'); answer(idx); }, 75);
    }
  } else {
    if (!['Tab','Shift','Meta','Alt','Control'].includes(e.key)) {
      e.preventDefault();
      skipAdvance();
    }
  }
});

// Tap anywhere outside dpad/modal to skip
document.addEventListener('pointerdown', e => {
  if (!S.answered || advancing || !advanceTimer) return;
  if (e.target.closest('.dpad-btn') || e.target.closest('.modal-card')) return;
  skipAdvance();
}, { passive: true });

// ═══════════════════════════════════════════════════════
// NEXT QUESTION
// ═══════════════════════════════════════════════════════

function nextQuestion() {
  if (advancing) return;
  advancing = true;
  clearTimeout(advanceTimer); advanceTimer = null;
  stopBar();

  const q = currentQ();

  if (S.wandering) {
    S.wi++;
    if (S.wi >= WANDERING_QS.length) {
      S.wandering = false;
      document.getElementById('wanderingBanner').className = 'wandering-banner';
      document.getElementById('wanderMark').setAttribute('opacity', '0');
      const prev = S.stage; S.stage = 5;
      S.qi = QUESTIONS.findIndex(q => q.stage === 5);
      syncMap(prev); renderQuestion();
    } else { renderQuestion(); }
    return;
  }

  if (q.isKadesh && S.kadeshFailed) {
    S.qi++;
    showModal('kadeshScreen');
    // Don't call renderQuestion here — modal takes over; advancing stays true until startWandering resets it
    return;
  }

  S.qi++;
  if (S.qi >= QUESTIONS.length) { showWin(); return; }

  const next = QUESTIONS[S.qi];
  if (next && next.stage !== S.stage) {
    const prev = S.stage; S.stage = next.stage; syncMap(prev);
  }
  renderQuestion();
}

function startWandering() {
  S.wandering = true; S.wi = 0;
  document.getElementById('wanderingBanner').className = 'wandering-banner show';
  document.getElementById('wanderMark').setAttribute('opacity', '1');
  hideModal('kadeshScreen');
  renderQuestion(); // resets advancing = false
}

// ═══════════════════════════════════════════════════════
// WIN
// ═══════════════════════════════════════════════════════

function showWin() {
  document.getElementById('wanderingBanner').className = 'wandering-banner';
  const prev = S.stage; S.stage = 6; syncMap(prev);
  const pct = Math.round(S.correct / QUESTIONS.length * 100);
  const out  = OUTCOMES.find(o => pct >= o.min);
  document.getElementById('winIcon').textContent     = out.icon;
  document.getElementById('playerTitle').textContent = out.title;
  document.getElementById('scoreBig').textContent    = `${S.correct}/${QUESTIONS.length}`;
  document.getElementById('scoreOf').textContent     = `questions correct (${pct}%)`;
  document.getElementById('winVerse').textContent    = out.verse;
  document.getElementById('bookRecText').textContent = out.book;
  showModal('winScreen');
}

// ═══════════════════════════════════════════════════════
// RESTART
// ═══════════════════════════════════════════════════════

function restartGame() {
  clearTimeout(advanceTimer); advanceTimer = null; advancing = false;
  S = { qi:0, correct:0, stage:0, wandering:false, wi:0, kadeshFailed:false, answered:false };
  document.getElementById('wanderMark').setAttribute('opacity', '0');
  hideModal('winScreen'); hideModal('kadeshScreen');
  document.getElementById('wanderingBanner').className = 'wandering-banner';
  buildDots(); syncMap(); renderQuestion();
}

// ═══════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════

buildStageMarkers();
buildDots();
syncMap();
renderQuestion();
</script>
